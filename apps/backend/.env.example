# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=visionx
DATABASE_PASSWORD=visionx_dev_password
DATABASE_NAME=visionx_eval

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRY=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=visionx-snapshots
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/visionx-eval

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Snapshot Config
SNAPSHOT_MAX_SIZE_MB=50
SNAPSHOT_INTERVAL_MINUTES=45
