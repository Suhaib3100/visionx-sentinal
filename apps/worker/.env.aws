# Worker AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_S3_BUCKET=visionx-snapshots-1771150863
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/668226797980/evaluation-jobs

# AWS Bedrock Configuration (Claude 3 Haiku - Most Cost-Effective)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_TEMPERATURE=0.3

# Alternative models (uncomment to use):
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0  # Better quality, higher cost
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-opus-20240229-v1:0    # Best quality, highest cost

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=20
WORKER_VISIBILITY_TIMEOUT=300
WORKER_MAX_RETRIES=3
