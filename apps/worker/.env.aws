# Worker AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_S3_BUCKET=visionx-snapshots-1771150863
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/668226797980/evaluation-jobs

# AWS Bedrock Configuration - Amazon Nova Micro (RECOMMENDED)
# AWS's own model - INSTANT ACCESS (no marketplace BS), 7x cheaper than Claude
# Pricing: $0.000035/1K input, $0.00014/1K output (SUPER CHEAP!)
AWS_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_TEMPERATURE=0.7

# Alternative models (all work immediately without marketplace):
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0  # Claude 3 Haiku (older, $0.00025/$0.00125)
# AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0  # Nova Lite (better quality, $0.0006/$0.0024)
# AWS_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0  # Nova Pro (best quality, $0.008/$0.032)

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=20
WORKER_VISIBILITY_TIMEOUT=300
WORKER_MAX_RETRIES=3
