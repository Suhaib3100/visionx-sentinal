# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=visionx_eval
DB_SYNC=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=visionx-snapshots
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/evaluation-jobs

# AWS Bedrock - Amazon Nova Micro (Recommended - instant access, super cheap)
AWS_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_TEMPERATURE=0.7

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=20
WORKER_VISIBILITY_TIMEOUT=300
WORKER_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
NODE_ENV=development
