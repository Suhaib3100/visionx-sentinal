# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=visionx
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=visionx_eval

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=visionx-snapshots
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-queue

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# LLM APIs
BEDROCK_API_URL=https://api.bedrock.aws
BEDROCK_API_KEY=your_bedrock_api_key_here
# Backend
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000

# Worker
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=5000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
