# VisionX Eval - AWS Configuration
# Generated: 2026-02-15

# ============================================================================
# DATABASE CONFIGURATION (RDS PostgreSQL)
# ============================================================================
# Status: Available / Backing-up
# DB Instance: visionx-eval-db

DATABASE_HOST=visionx-eval-db.c0bcckgyq55z.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=visionx
DATABASE_PASSWORD=RESET_PASSWORD_SEE_INSTRUCTIONS_BELOW
DATABASE_NAME=visionx_eval

# ============================================================================
# AWS RESOURCES
# ============================================================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=visionx-eval-snapshots
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/668226797980/visionx-eval-jobs

# ============================================================================
# AI CONFIGURATION (Amazon Nova Micro)
# ============================================================================
AI_PROVIDER=bedrock
AI_MODEL=amazon.nova-micro-v1:0

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
JWT_SECRET=<GENERATE_WITH_openssl_rand_-base64_32>
NODE_ENV=production
PORT=3000

# ============================================================================
# OPTIONAL: Redis (for leaderboard caching)
# ============================================================================
# REDIS_HOST=your-redis-endpoint
# REDIS_PORT=6379

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Wait for RDS database to be available (5-10 minutes)
#    Check status: aws rds describe-db-instances --db-instance-identifier visionx-db
#
# 2. Get database endpoint:
#    aws rds describe-db-instances --db-instance-identifier visionx-db --query 'DBInstances[0].Endpoint.Address' --output text
#  
# 3. Update DATABASE_HOST with the actual endpoint
#
# 4. Generate JWT secret:
#    openssl rand -base64 32
#
# 5. Update security group to allow access:
#    aws ec2 authorize-security-group-ingress --group-id sg-0d51d14501b975ef8 --protocol tcp --port 5432 --cidr 0.0.0.0/0
#
# 6. Copy this file to your apps:
#    cp aws-config.env apps/backend/.env
#    cp aws-config.env apps/worker/.env
#
# 7. Test database connection:
#    psql -h <DATABASE_HOST> -U visionxadmin -d visionx_eval
